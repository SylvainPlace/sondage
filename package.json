{
  "name": "sondage-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:fix": "oxfmt --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check",
    "check:fix": "npm run lint:fix && npm run format:fix",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "prepare": "husky",
    "cf:types": "wrangler types --env-interface CloudflareEnv"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "geojson": "^0.5.0",
    "jose": "^6.2.10",
    "knip": "^6.33.0",
    "leaflet": "^1.9.4",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@opennextjs/cloudflare": "^1.20.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.123.0"
  }
}

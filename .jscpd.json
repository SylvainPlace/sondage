{
  "threshold": 10,
  "min-tokens": 50,
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.open-next/**",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.d.ts"
  ],
  "absolute": false,
  "blame": false,
  "mode": "strict",
  "silent": false
}
